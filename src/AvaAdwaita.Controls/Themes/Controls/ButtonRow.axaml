<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- row.button.activatable > box.horizontal > image.icon.start + label.title + image.icon.end, as adw-button-row.ui. -->
  <ControlTheme x:Key="{x:Type adw:ButtonRow}" TargetType="adw:ButtonRow">
    <Setter Property="adw:Css.Node" Value="row" />
    <Setter Property="adw:Css.Classes" Value="button" />
    <Setter Property="adw:Css.Position" Value="Item" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox>
          <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="horizontal" HorizontalAlignment="Center">
            <adw:AdwStack Orientation="Horizontal">
              <adw:AdwIcon adw:Css.Classes="icon start" IconName="{TemplateBinding StartIconName}" VerticalAlignment="Center"
                           IsVisible="{TemplateBinding StartIconName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <adw:AdwLabel adw:Css.Node="label" adw:Css.Classes="title" Text="{TemplateBinding Title}" RecognizesAccessKey="{TemplateBinding UseUnderline}"
                            TextAlignment="Center" TextTrimming="CharacterEllipsis"
                            IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <adw:AdwIcon adw:Css.Classes="icon end" IconName="{TemplateBinding EndIconName}" VerticalAlignment="Center"
                           IsVisible="{TemplateBinding EndIconName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </adw:AdwStack>
          </adw:AdwBox>
        </adw:AdwBox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
