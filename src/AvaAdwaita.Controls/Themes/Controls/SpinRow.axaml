<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- row.spin.activatable > box.header > box.title, box.suffixes > spinbutton, as adw-spin-row.ui. -->
  <ControlTheme x:Key="{x:Type adw:SpinRow}" TargetType="adw:SpinRow" BasedOn="{StaticResource {x:Type adw:ActionRow}}">
    <Setter Property="adw:Css.Classes" Value="spin" />
  </ControlTheme>
</ResourceDictionary>
