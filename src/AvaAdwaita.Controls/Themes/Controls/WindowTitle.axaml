<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- windowtitle > box.vertical > label.title + label.subtitle, as adw-window-title.ui. -->
  <ControlTheme x:Key="{x:Type adw:WindowTitle}" TargetType="adw:WindowTitle">
    <Setter Property="adw:Css.Node" Value="windowtitle" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox>
          <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="vertical" VerticalAlignment="Center">
            <adw:AdwStack Orientation="Vertical">
              <adw:AdwLabel adw:Css.Node="label" adw:Css.Classes="title" Text="{TemplateBinding Title}" TextAlignment="Center" WidthChars="5"
                            TextTrimming="CharacterEllipsis" MaxLines="1"
                            IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <adw:AdwLabel adw:Css.Node="label" adw:Css.Classes="subtitle" Text="{TemplateBinding Subtitle}" TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" MaxLines="1"
                            IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </adw:AdwStack>
          </adw:AdwBox>
        </adw:AdwBox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
