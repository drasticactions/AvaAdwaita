<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- row.activatable > box.header > box.title, box.suffixes > switch, as AdwSwitchRow adds its switch. -->
  <ControlTheme x:Key="{x:Type adw:SwitchRow}" TargetType="adw:SwitchRow" BasedOn="{StaticResource {x:Type adw:ActionRow}}" />
</ResourceDictionary>
