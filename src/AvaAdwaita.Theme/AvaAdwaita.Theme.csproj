<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AvaAdwaita</RootNamespace>
    <PackageId>AvaAdwaita.Theme</PackageId>
    <Description>libadwaita CSS integration for Avalonia applications.</Description>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sources\Bundled\gtk-1.10.0.css" LogicalName="AvaAdwaita.Bundled.gtk.css" />
    <EmbeddedResource Include="Sources\Bundled\assets\*.svg" LogicalName="AvaAdwaita.Bundled.assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\Bundled\*.svg" LogicalName="AvaAdwaita.Icons.%(Filename)%(Extension)" />
    <None Include="Icons\Bundled\LICENSE.icons" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvaAdwaita.DataGrid" />
    <InternalsVisibleTo Include="AvaAdwaita.Controls" />
    <InternalsVisibleTo Include="AvaAdwaita.Theme.Tests" />
    <InternalsVisibleTo Include="AvaAdwaita.Gallery" />
  </ItemGroup>

  <Import Project="..\SharedThemes.targets" />

</Project>
