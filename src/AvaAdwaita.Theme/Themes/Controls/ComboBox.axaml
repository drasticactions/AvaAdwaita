<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- dropdown > button.toggle > box.horizontal > (stack > label) + arrow; the list is popover.menu > contents > listview > row -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="adw:Css.Node" Value="dropdown" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- GtkDropDown's scrolled list is at most 400 tall (max-content-height). -->
    <Setter Property="MaxDropDownHeight" Value="400" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox>
          <Panel>
            <adw:AdwBox adw:Css.Node="button" adw:Css.Classes="toggle" adw:Css.StateSource="TemplatedParent">
              <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="horizontal">
                <adw:AdwStack Orientation="Horizontal">
                  <adw:AdwBox adw:Css.Node="stack" adw:AdwStack.Expand="True">
                    <Panel>
                      <!-- GtkDropDown's stack shows a placeholder label or the selected item's row. -->
                      <adw:AdwLabel adw:Css.Node="label" Text="{TemplateBinding PlaceholderText}" Opacity="0.55"
                                    IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                      <adw:AdwBox adw:Css.Node="row" adw:Css.Classes="activatable" adw:Css.StateSource="None"
                                  IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="horizontal">
                          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="Stretch">
                            <ContentPresenter.DataTemplates>
                              <adw:LabelTemplate />
                            </ContentPresenter.DataTemplates>
                          </ContentPresenter>
                        </adw:AdwBox>
                      </adw:AdwBox>
                    </Panel>
                  </adw:AdwBox>
                  <adw:AdwIcon adw:Css.Node="arrow" />
                </adw:AdwStack>
              </adw:AdwBox>
            </adw:AdwBox>
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Decorator>
                <adw:AdwBox adw:Css.Node="popover" adw:Css.Classes="menu background">
                  <adw:PopoverContents MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}">
                    <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="vertical">
                      <!-- scrolledwindow > listview, as GtkDropDown's popup: libadwaita pads the list and its rows there. -->
                      <ScrollViewer Classes="adw-scrollable-child" MaxHeight="{TemplateBinding MaxDropDownHeight}" HorizontalScrollBarVisibility="Disabled">
                        <adw:AdwBox adw:Css.Node="listview" adw:Css.Classes="view">
                          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </adw:AdwBox>
                      </ScrollViewer>
                    </adw:AdwBox>
                  </adw:PopoverContents>
                </adw:AdwBox>
              </Decorator>
            </Popup>
          </Panel>
        </adw:AdwBox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- row > box.horizontal > label + image: GtkDropDown's list item shows object-select-symbolic after the selected item's label. -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="adw:Css.Node" Value="row" />
    <Setter Property="adw:Css.Position" Value="Item" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox>
          <adw:AdwBox adw:Css.Node="box" adw:Css.Classes="horizontal">
            <adw:AdwStack Orientation="Horizontal">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.DataTemplates>
                  <adw:LabelTemplate />
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
              <adw:AdwIcon Name="PART_Check" IconName="object-select-symbolic" Opacity="0" />
            </adw:AdwStack>
          </adw:AdwBox>
        </adw:AdwBox>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected /template/ adw|AdwIcon#PART_Check">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
