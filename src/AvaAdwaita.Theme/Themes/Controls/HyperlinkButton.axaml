<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- GtkLinkButton: button.link.flat (.text-button) > label, :link until visited -->
  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton" BasedOn="{StaticResource AdwButtonBase}">
    <Setter Property="adw:Css.Classes" Value="flat link" />
    <Setter Property="adw:Css.States" Value="Link" />
    <Style Selector="^:visited">
      <Setter Property="adw:Css.States" Value="None" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
