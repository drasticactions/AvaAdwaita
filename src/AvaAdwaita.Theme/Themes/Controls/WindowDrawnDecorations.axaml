<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <!-- The Window theme draws the frame, the shadow and the header bar itself; these decorations only reserve
       the shadow space, which WindowChrome computes from the window's box-shadow. -->
  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="0" />
    <Setter Property="DefaultFrameThickness" Value="0" />
    <Setter Property="DefaultShadowThickness" Value="25" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Panel IsHitTestVisible="False" />
          </WindowDrawnDecorationsContent.Underlay>
        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
