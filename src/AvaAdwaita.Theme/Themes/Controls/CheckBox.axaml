<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- checkbutton.text-button > check + label; the check mark is check's -gtk-icon-source. -->
  <ControlTheme x:Key="AdwCheckButton" TargetType="ToggleButton">
    <Setter Property="adw:Css.Node" Value="checkbutton" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox>
          <adw:AdwStack Orientation="Horizontal">
            <adw:AdwIcon Name="PART_Check" adw:Css.Node="check" VerticalAlignment="Center" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Stretch"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter.DataTemplates>
                <adw:LabelTemplate RecognizesAccessKey="True" />
              </ContentPresenter.DataTemplates>
            </ContentPresenter>
          </adw:AdwStack>
        </adw:AdwBox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox" BasedOn="{StaticResource AdwCheckButton}" />
</ResourceDictionary>
