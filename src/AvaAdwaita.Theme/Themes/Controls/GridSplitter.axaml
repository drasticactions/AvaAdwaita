<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adw="https://github.com/avaadwaita"
                    x:ClassModifier="internal">
  <!-- GtkPaned: the grid holding the splitter is paned (.horizontal, .vertical), the splitter its separator
       (.wide with Classes="wide"), and its neighbors the panes. -->
  <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
    <Setter Property="adw:Css.Node" Value="separator" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <adw:AdwBox />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
