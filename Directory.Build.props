<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <Authors>drasticactions</Authors>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/drasticactions/avaadwaita</PackageProjectUrl>
    <RepositoryUrl>https://github.com/drasticactions/avaadwaita</RepositoryUrl>
    <PackageTags>avalonia;theme;gnome;adwaita;libadwaita;gtk;linux</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaAdwaitaRepoRoot>$(MSBuildThisFileDirectory)</AvaAdwaitaRepoRoot>
    <AvaAdwaitaLibadwaitaVersion>1.10.0</AvaAdwaitaLibadwaitaVersion>
    <AvaAdwaitaRevision>0</AvaAdwaitaRevision>
    <Version>$(AvaAdwaitaLibadwaitaVersion).$(AvaAdwaitaRevision)</Version>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(AvaAdwaitaRepoRoot)Key.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AvaAdwaitaIsLibrary)' != 'false'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(AvaAdwaitaIsLibrary)' != 'false'">
    <None Include="$(AvaAdwaitaRepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(AvaAdwaitaRepoRoot)NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(AvaAdwaitaRepoRoot)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
