<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:adw="https://github.com/avaadwaita"
             xmlns:local="clr-namespace:AvaAdwaita.Gallery"
             x:Class="AvaAdwaita.Gallery.MainView">
  <DockPanel>
    <Border Name="OwnHeader" DockPanel.Dock="Top" IsVisible="False" Padding="12,6">
      <local:StylePanel Orientation="Horizontal" />
    </Border>
    <!-- AdwOverlaySplitView with a navigation sidebar, as a libadwaita app's. -->
    <SplitView Name="Split" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="220">
      <SplitView.Pane>
        <ListBox Name="Pages" Classes="navigation-sidebar" />
      </SplitView.Pane>
      <ScrollViewer Name="PageHost" HorizontalScrollBarVisibility="Disabled" />
    </SplitView>
  </DockPanel>
</UserControl>
