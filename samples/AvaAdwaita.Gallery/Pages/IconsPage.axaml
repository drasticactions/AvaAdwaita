<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:adw="https://github.com/avaadwaita"
             x:Class="AvaAdwaita.Gallery.Pages.IconsPage">
  <StackPanel Classes="gallery-page">
    <Label Classes="title-1" Content="Icons" />
    <StackPanel Classes="gallery-section">
      <Label Classes="heading" Content="Bundled symbolic icons" />
      <ItemsControl Name="Bundled">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <StackPanel Width="120" Spacing="6">
              <adw:AdwIcon IconName="{Binding}" HorizontalAlignment="Center" />
              <adw:AdwLabel adw:Css.Node="label" adw:Css.Classes="caption dim-label" Text="{Binding}"
                            TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Classes="gallery-section">
      <Label Classes="heading" Content="Large" />
      <WrapPanel Classes="gallery-row">
        <adw:AdwIcon Classes="icon-dropshadow large-icons" IconName="folder-symbolic" />
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
